<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>LabsApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
    <!-- C-004 (IF-003): выпуск и валидация JWT HS256 (access и reset-токены). -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.5.0" />
    <!-- SEC-001 (GHSA-73j8-2gch-69rq, High): прямая ссылка переводит транзитивное
         разрешение Microsoft.IdentityModel.Tokens 8.5.0 с уязвимой 9.0.0 на
         пропатченную 9.0.14 — первую исправленную версию линейки 9.0.x по
         консультативу (уязвимы 9.0.0–9.0.13); nearest-wins. Гейт пустого вывода
         dotnet list package с ключами vulnerable и include-transitive —
         DependencyVulnerabilityGateTests в LabsApp.Tests. -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="9.0.14" />
  </ItemGroup>

</Project>
