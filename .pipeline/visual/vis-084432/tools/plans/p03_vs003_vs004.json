{
 "name": "p03_vs003_vs004",
 "viewport": {
  "width": 1280,
  "height": 900
 },
 "steps": [
  {
   "do": "clearStorage"
  },
  {
   "do": "goto",
   "url": "/recovery",
   "waitFor": "#email-input",
   "timeout": 30000
  },
  {
   "do": "screenshot",
   "name": "VS003-recovery-desktop",
   "fullPage": false
  },
  {
   "do": "type",
   "sel": "#email-input",
   "text": "student01@example.com"
  },
  {
   "do": "click",
   "sel": "button[type=submit]"
  },
  {
   "do": "wait",
   "ms": 1800
  },
  {
   "do": "eval",
   "js": "(() => location.pathname)()",
   "as": "afterRequestPath"
  },
  {
   "do": "screenshot",
   "name": "VS003-recovery-code-desktop",
   "fullPage": false
  },
  {
   "do": "textDump",
   "as": "codePageText"
  },
  {
   "do": "eval",
   "js": "(() => ({ resend: document.body.innerText.includes('Переотправить код'), cancel: document.body.innerText.includes('Отмена') }))()",
   "as": "linksCheck"
  },
  {
   "do": "clickText",
   "sel": "a, button",
   "text": "Отмена",
   "idx": 0
  },
  {
   "do": "wait",
   "ms": 1200
  },
  {
   "do": "eval",
   "js": "(() => location.pathname)()",
   "as": "afterCancelPath"
  },
  {
   "do": "screenshot",
   "name": "VS003-cancel-back-login",
   "fullPage": false
  },
  {
   "do": "goto",
   "url": "/recovery",
   "waitFor": "#email-input",
   "timeout": 30000
  },
  {
   "do": "type",
   "sel": "#email-input",
   "text": "student01@example.com"
  },
  {
   "do": "click",
   "sel": "button[type=submit]"
  },
  {
   "do": "wait",
   "ms": 1800
  },
  {
   "do": "eval",
   "js": "(() => { const db = JSON.parse(localStorage.getItem('mock.db.v1')); const c = db.recoveryCodes.filter(c => !c.usedAt).pop(); return c ? c.code : 'none'; })()",
   "as": "codeValue"
  },
  {
   "do": "focus",
   "sel": "#code-input"
  },
  {
   "do": "typePage",
   "text": "000000"
  },
  {
   "do": "click",
   "sel": "button[type=submit]"
  },
  {
   "do": "wait",
   "ms": 1500
  },
  {
   "do": "screenshot",
   "name": "VS003-code-wrong-desktop",
   "fullPage": false
  },
  {
   "do": "eval",
   "js": "(() => ({ t: document.body.innerText.includes('Код восстановления не подходит') }))()",
   "as": "wrongCodeCheck"
  },
  {
   "do": "setValueJs",
   "sel": "#code-input",
   "js": "(JSON.parse(localStorage.getItem('mock.db.v1')).recoveryCodes.filter(c => !c.usedAt).pop() || {}).code || '000000'"
  },
  {
   "do": "click",
   "sel": "button[type=submit]"
  },
  {
   "do": "wait",
   "ms": 1800
  },
  {
   "do": "eval",
   "js": "(() => location.pathname)()",
   "as": "afterCodePath"
  },
  {
   "do": "screenshot",
   "name": "VS003-reset-password-reached",
   "fullPage": false
  },
  {
   "do": "wait",
   "ms": 500
  },
  {
   "do": "screenshot",
   "name": "VS004-reset-desktop-form",
   "fullPage": false
  },
  {
   "do": "textDump",
   "as": "resetFormText"
  },
  {
   "do": "clearStorage"
  },
  {
   "do": "eval",
   "js": "(() => { sessionStorage.setItem('recovery.flow.v1', JSON.stringify({ email: 'student01@example.com', resetToken: 'expired-or-invalid-token' })); return 'set'; })()",
   "as": "setBadToken"
  },
  {
   "do": "goto",
   "url": "/reset-password",
   "waitFor": "#password-input",
   "timeout": 30000
  },
  {
   "do": "setValue",
   "sel": "#password-input",
   "value": "NewPass123!"
  },
  {
   "do": "setValue",
   "sel": "#repeat-password-input",
   "value": "NewPass123!"
  },
  {
   "do": "click",
   "sel": "button[type=submit]"
  },
  {
   "do": "wait",
   "ms": 1800
  },
  {
   "do": "screenshot",
   "name": "VS004-reset-desktop-terminal",
   "fullPage": false
  },
  {
   "do": "eval",
   "js": "(() => ({ banner: document.body.innerText.includes('Ссылка восстановления недействительна или истекла'), link: document.body.innerText.includes('Запросить код заново'), formOpen: !!document.querySelector('#password-input') }))()",
   "as": "terminalCheck"
  }
 ]
}