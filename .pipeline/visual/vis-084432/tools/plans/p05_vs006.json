{
 "name": "p05_vs006",
 "viewport": {
  "width": 1280,
  "height": 900
 },
 "steps": [
  {
   "do": "clearStorage"
  },
  {
   "do": "goto",
   "url": "/login",
   "waitFor": "#login-input",
   "timeout": 30000
  },
  {
   "do": "eval",
   "js": "(() => [...document.querySelectorAll('.guest-topbar__tab')].map(a => a.textContent.trim()))()",
   "as": "guestTabs"
  },
  {
   "do": "screenshot",
   "name": "VS006-guest-header",
   "fullPage": false
  },
  {
   "do": "eval",
   "js": "(() => [...document.querySelectorAll('.guest-topbar__tab')].map(a => ({ t: a.textContent.trim(), href: a.getAttribute('href') })))()",
   "as": "guestTabLinks"
  },
  {
   "do": "type",
   "sel": "#login-input",
   "text": "student01"
  },
  {
   "do": "type",
   "sel": "#password-input",
   "text": "student123!"
  },
  {
   "do": "click",
   "sel": "button[type=submit]"
  },
  {
   "do": "wait",
   "ms": 1700
  },
  {
   "do": "eval",
   "js": "(() => [...document.querySelectorAll('.app-topbar__tab')].map(a => a.textContent.trim()))()",
   "as": "studentTabs"
  },
  {
   "do": "screenshot",
   "name": "VS006-student-header",
   "fullPage": false
  },
  {
   "do": "click",
   "sel": ".app-topbar__logout"
  },
  {
   "do": "wait",
   "ms": 1500
  },
  {
   "do": "eval",
   "js": "(() => [...document.querySelectorAll('.guest-topbar__tab')].map(a => a.textContent.trim()))()",
   "as": "guestTabsAfterLogout"
  },
  {
   "do": "type",
   "sel": "#login-input",
   "text": "teacher"
  },
  {
   "do": "type",
   "sel": "#password-input",
   "text": "teacher123!"
  },
  {
   "do": "click",
   "sel": "button[type=submit]"
  },
  {
   "do": "wait",
   "ms": 1700
  },
  {
   "do": "eval",
   "js": "(() => [...document.querySelectorAll('.app-topbar__tab')].map(a => a.textContent.trim()))()",
   "as": "teacherTabs"
  },
  {
   "do": "screenshot",
   "name": "VS006-teacher-header",
   "fullPage": false
  }
 ]
}