# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.ts]
quote_type = single
ij_typescript_use_double_quotes = false

# Код C# в src/api пишется с отступом 4: без секции общий [*] с indent_size = 2
# заставил бы dotnet format переписать все файлы API под 2 пробела.
[*.cs]
indent_size = 4

[*.md]
max_line_length = off
trim_trailing_whitespace = false
