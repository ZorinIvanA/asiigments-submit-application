{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "268e01a6-a305-4d3e-9de9-0d4052c8c5b6"
  },
  "newProjectRoot": "projects",
  "projects": {
    "asiigments-submit-application": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src/client",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/client/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/primeicons/primeicons.css",
              "src/client/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "src/client/proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "asiigments-submit-application:build:production"
            },
            "development": {
              "buildTarget": "asiigments-submit-application:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/primeicons/primeicons.css",
              "src/client/styles.scss"
            ]
          }
        }
      }
    },
    "integration-b06": {
      "projectType": "application",
      "root": "tests/integration/B-06",
      "sourceRoot": "tests/integration/B-06",
      "prefix": "app",
      "architect": {
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "tests/integration/B-06/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "integration-b17": {
      "projectType": "application",
      "root": "tests/integration/B-17",
      "sourceRoot": "tests/integration/B-17",
      "prefix": "app",
      "architect": {
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "tests/integration/B-17/tsconfig.spec.json",
            "karmaConfig": "tests/integration/B-17/karma.conf.cjs",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "integration-b18": {
      "projectType": "application",
      "root": "tests/integration/B-18",
      "sourceRoot": "tests/integration/B-18",
      "prefix": "app",
      "architect": {
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "tests/integration/B-18/tsconfig.spec.json",
            "karmaConfig": "tests/integration/B-18/karma.conf.cjs",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    }
  }
}
