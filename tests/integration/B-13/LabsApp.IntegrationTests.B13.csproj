<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Интеграционные тесты батча B-13 (submissions: GET /submissions — FR-060,
    GET /me/submissions — FR-062; semesters — FR-018; scope TS-195; кейсы
    TS-101, TS-148..TS-152, TS-160, TS-162, TS-195). Recovery/reset- и
    refresh-сценарии (TS-064..TS-085, TS-197) удалены вместе с аутентификацией
    приложения: auth-эндпойнтов больше нет, все эндпойнты анонимны.
    Зона батча: tests/integration/B-13.
    Реализация (src/api) не изменяется: LabsApp остаётся net8.0 (FR-001); зона
    ссылается на него ProjectReference и не включается в solution src/api —
    батчи пишут зоны параллельно (образец — зоны B-01..B-11; урок BL-001
    BUG-001: собственный проект зоны вместо правки общего тестового проекта).

    Тестовый проект — net8.0 (ранее net10.0 — адаптация окружения прогона без runtime 8, как у зон B-01..B-11):
    на исходном хосте прогона не было runtime .NET 8 (только SDK 10 и runtime 9/10); с рантаймом 8.x зона возвращена на net8.0 и Mvc.Testing 8.0.*.
    Mvc.Testing 10.0.12 (историческое обоснование прежнего net10.0) — под net10.0: TestServer реализует
    PipeWriter.UnflushedBytes, требуемый System.Text.Json фреймворка 9/10.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TestInfrastructure\LabsApp.TestInfrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\api\LabsApp\LabsApp.csproj" />
  </ItemGroup>

</Project>
