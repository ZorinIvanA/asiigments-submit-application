<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Интеграционные тесты волны B-08 «репозитории: подмена реализаций и
    атомарность уникальностей» (FR-006, FR-017, FR-024, NFR-005; кейсы
    TS-175..TS-178). Зона батча: tests/integration/B-08/Repositories —
    обособленный тестовый проект внутри зоны B-08 (образец — собственные
    проекты поддеревьев Auth/, Groups/, Limiters/ этой же зоны; урок BL-001
    BUG-001: собственный проект вместо правки чужих). Файлы предыдущих волн
    зоны B-08 (Scenarios/Ts061..Ts075, Infrastructure/B08*, Auth/, Groups/,
    Limiters/) не изменяются и не используются: этот проект собирает ТОЛЬКО
    собственное поддерево Repositories/ (корневой csproj зоны исключает
    поддерево из своей глобб-компиляции — тот же механизм, что для
    Auth/Groups/Limiters).

    Реализация (src/api) не изменяется: LabsApp остаётся net8.0 (FR-001); зона
    ссылается на него ProjectReference. Тестовый проект — net10.0 (адаптация
    окружения прогона, как у остальных зон): на хосте только SDK 10.0.112 и
    runtime 9/10, runtime .NET 8 отсутствует. Microsoft.AspNetCore.Mvc.Testing
    10.0.12 — под net10.0: TestServer реализует PipeWriter.UnflushedBytes,
    требуемый System.Text.Json фреймворка 9/10. Проверяемое поведение —
    HTTP-контракты /api/v1 и DI-композиция FR-024, не зависящие от TFM
    тестового хоста.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Глобальные using этого проекта — ТОЛЬКО через MSBuild-элемент Using (не
    файлом GlobalUsings.cs): файл зоны tests/integration/B-08/GlobalUsings.cs
    предыдущей волны остаётся вне этого проекта, а повторные global using
    (TreatWarningsAsErrors) недопустимы.
  -->
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\api\LabsApp\LabsApp.csproj" />
  </ItemGroup>

</Project>
