<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Интеграционные тесты батча B-08 (репозитории: подмена реализаций и
    атомарность уникальностей — FR-006, FR-017, FR-019, FR-020, FR-024;
    кейсы TS-165..TS-169; доменные кейсы групп TS-122..TS-128, TS-202,
    TS-204 снесены как дубликаты — владелец кейсов зона
    tests/integration/B-17/Groups).
    Зона батча: tests/integration/B-08/Groups — обособленный тестовый проект
    внутри зоны B-08 (образец — собственные проекты зон B-01..B-21; урок BL-001
    BUG-001: собственный проект вместо правки чужих). Файлы предыдущих волн
    зоны B-08 (Scenarios/Ts061..Ts075, Infrastructure/B08*) не изменяются и не
    используются: этот проект собирает ТОЛЬКО собственное поддерево Groups/.

    Реализация (src/api) не изменяется: LabsApp остаётся net8.0 (FR-001); зона
    ссылается на него ProjectReference. Тестовый проект — net10.0 (адаптация
    окружения прогона, как у зон B-01..B-21): на хосте только SDK 10.0.112 и
    runtime 9/10, runtime .NET 8 отсутствует. Microsoft.AspNetCore.Mvc.Testing
    10.0.12 — под net10.0: TestServer реализует PipeWriter.UnflushedBytes,
    требуемый System.Text.Json фреймворка 9/10. Проверяемое поведение —
    HTTP-контракты /api/v1, не зависящие от TFM тестового хоста.

    Тесты обращаются к серверу только через HTTP-контракт спеки (WebApplication-
    Factory<Program> + HttpClient, сессии — POST /auth/login; данные — демо-сид
    Seed__DemoData=true, воспроизводящий mock/seed.ts): черноящичность делает
    зону устойчивой к реворку internals (консолидация ISecurityTokenRepository,
    выделение IRateLimitStore — FR-024).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Глобальные using этого проекта — ТОЛЬКО через MSBuild-элемент Using (не
    файлом GlobalUsings.cs): файл зоны tests/integration/B-08/GlobalUsings.cs
    предыдущей волны остаётся вне этого проекта, а повторные global using
    в корневом проекте зоны (TreatWarningsAsErrors) недопустимы.
  -->
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\api\LabsApp\LabsApp.csproj" />
  </ItemGroup>

</Project>
