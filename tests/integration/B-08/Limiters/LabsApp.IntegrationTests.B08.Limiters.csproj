<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Интеграционные тесты волны B-08 «лимитер/матрица лимитов/KDF» (кейсы
    TS-011..TS-025): движок скользящего окна с потолком 10000 ключей и
    overflow-корзиной (FR-003/NFR-003, IF-006), матрица лимитов
    login/register/recovery_request (FR-004; FR-007 login, FR-012 recovery),
    KDF-сервис (FR-005, IF-002), README-реестр амплитуд (FR-028).
    Зона батча: tests/integration/B-08/Limiters — обособленный тестовый проект
    внутри зоны B-08 (образец — вложенные проекты Auth/ и Groups/ той же зоны
    и собственные проекты зон B-01..B-21; урок BL-001 BUG-001: собственный
    проект вместо правки чужих файлов). Файлы предыдущих волн зоны B-08
    (Scenarios/Ts061..Ts075, Infrastructure/B08*, Auth/, Groups/) не изменяются
    и не используются: этот проект собирает ТОЛЬКО собственное поддерево
    Limiters/; исключение поддерева из компиляции корневого проекта зоны —
    в LabsApp.IntegrationTests.B08.csproj (тот же механизм, что для Auth/).

    Реализация (src/api) не изменяется: LabsApp остаётся net8.0 (FR-001); зона
    ссылается на него ProjectReference. Тестовый проект — net10.0 (адаптация
    окружения прогона, как у зон B-01..B-21): на хосте только SDK 10.0.112 и
    runtime 9/10, runtime .NET 8 отсутствует. Microsoft.AspNetCore.Mvc.Testing
    10.0.12 — под net10.0: TestServer реализует PipeWriter.UnflushedBytes,
    требуемый System.Text.Json фреймворка 9/10. Проверяемое поведение —
    HTTP-контракты /api/v1, DI-швы ядра Auth.Core (IPasswordHasher — IF-002;
    IRateLimitStore — IF-006) и чистый движок лимитера, не зависящие от TFM
    тестового хоста.

    Microsoft.Extensions.TimeProvider.Testing — FakeTimeProvider сценариев
    с бизнес-временем (TS-011/TS-012/TS-015/TS-018/TS-020: фиксированное время
    и скольжение окна лимитера; глоссарий TimeProvider / ADR-002).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    FrameworkReference — явный: инфраструктура зоны пользуется типами shared
    framework (WebApplicationFactory, ILogger и т.п.), которые с
    ProjectReference на Sdk.Web-проект транзитивно доступны, но явная ссылка
    фиксирует это независимо от формы зависимостей LabsApp.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Глобальные using этого проекта — ТОЛЬКО через MSBuild-элемент Using (не
    файлом GlobalUsings.cs): файл зоны tests/integration/B-08/GlobalUsings.cs
    предыдущих волн остаётся вне этого проекта, а повторные global using
    (TreatWarningsAsErrors) недопустимы.
  -->
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.Net" />
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\api\LabsApp\LabsApp.csproj" />
  </ItemGroup>

</Project>
