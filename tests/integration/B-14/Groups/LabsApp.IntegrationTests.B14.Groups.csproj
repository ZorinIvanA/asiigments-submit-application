<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Интеграционные тесты батча B-14 (группы: список/CRUD/состав — FR-019, FR-020;
    кейсы TS-102, TS-103, TS-104, TS-105, TS-106, TS-160). Зона батча:
    tests/integration/B-14 — обособленный тестовый проект в поддереве Groups/
    (образец — подпроекты B-17/Groups и B-08/Groups; урок BL-001 BUG-001:
    собственный проект зоны вместо правки чужих). Файлы предыдущей волны зоны
    B-14 (Scenarios/Ts068..Ts207 — recovery/profile/password, Infrastructure/
    B14*.cs, LabsApp.IntegrationTests.B14.csproj) НЕ изменяются и НЕ
    используются: они ссылаются на удалённые из приложения типы
    (IRefreshTokenRepository, IRecoveryCodeRepository — консолидация
    ISecurityTokenRepository) и не собираются; этот проект собирает ТОЛЬКО
    поддерево Groups/.

    Реализация (src/api) не изменяется: LabsApp остаётся net8.0 (FR-001); зона
    ссылается на него ProjectReference. Тестовый проект — net10.0 (адаптация
    окружения прогона, как у зон B-01..B-22): на хосте только SDK 10.0.112 и
    runtime 9/10, runtime .NET 8 отсутствует. Microsoft.AspNetCore.Mvc.Testing
    10.0.12 — под net10.0: TestServer реализует PipeWriter.UnflushedBytes,
    требуемый System.Text.Json фреймворка 9/10. Проверяемое поведение —
    HTTP-контракты /api/v1, не зависящие от TFM тестового хоста.

    Сессии — минт access-JWT через ITokenService тестового хоста (ADR-015:
    DI-сид + минт вместо POST /auth/login, доменная волна групп не зависит от
    auth-эндпоинтов); данные given кейсов — демо-сид Seed__DemoData=true
    (воспроизводит src/client/app/mock/seed.ts: ИК-221 (25 студентов),
    ИК-222 (5), ИК-223 (0), student01..student32).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Глобальные using этого проекта — ТОЛЬКО через MSBuild-элемент Using (не
    файлом GlobalUsings.cs): файл зоны tests/integration/B-14/GlobalUsings.cs
    предыдущей волны остаётся вне этого проекта, а повторные global using
    (TreatWarningsAsErrors) недопустимы.
  -->
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\api\LabsApp\LabsApp.csproj" />
  </ItemGroup>

</Project>
