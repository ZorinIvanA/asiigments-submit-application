<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Интеграционные тесты батча B-14 (профиль: GET /api/v1/me/profile — FR-020;
    смена пароля из профиля: PUT /api/v1/me/password — FR-022/SEC-006:
    TS-087, TS-088, TS-097, TS-098, TS-099, TS-196, TS-202).
    Зона батча: tests/integration/B-14. Реализация (src/api) не изменяется:
    LabsApp остаётся net8.0 (FR-001); зона ссылается на него ProjectReference
    и не включается в solution src/api — батчи пишут зоны параллельно
    (образец — зоны B-01..B-07; урок BL-001 BUG-001: собственный проект зоны
    вместо правки общего LabsApp.Tests).

    Предусловия НЕ зависят от эндпоинтов авторизации (арбитраж a-017/CR-001):
    пользователи/группы создаются прямым DI-сидом в IUserRepository/IGroupRepository
    тестового хоста (методика NFR-001/FR-007/ADR-010), пароли сидов хэшируются
    реальным IPasswordHasher хоста (IF-002); сессии минтятся харнесом
    (access-JWT HS256 ключом Auth__JwtKey тестового хоста через ITokenService,
    ADR-022), refresh-токены «устройств» — ITokenService.CreateRefreshToken +
    IRefreshTokenRepository.Add (хранится только TokenHash, IF-003/IF-015);
    cookie передаются заголовком явно (урок CR-002: CookieContainer не возвращает
    Secure-cookie для http). Шаги then кейсов TS-097/TS-202 «вход …», «POST
    /auth/refresh …» — живые вызовы POST /auth/login и POST /auth/refresh по букве
    кейса (это проверяемая часть, а не предусловие).

    Тестовый проект — net8.0 (ранее net10.0 — адаптация окружения прогона без runtime 8, как у зон B-01..B-15):
    на исходном хосте прогона не было runtime .NET 8 (только SDK 10 и runtime 9/10); с рантаймом 8.x зона возвращена на net8.0 и Mvc.Testing 8.0.*.
    Mvc.Testing 10.0.12 (историческое обоснование прежнего net10.0) — под net10.0: TestServer реализует
    PipeWriter.UnflushedBytes, требуемый System.Text.Json фреймворка 9/10.
    Проверяемое поведение — HTTP-контракты /api/v1, не зависящие от TFM тестового хоста.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Поддерево Groups/ — ОТДЕЛЬНЫЙ тестовый проект (Groups/
    LabsApp.IntegrationTests.B14.Groups.csproj, зона волны репозиториев).
    Без исключения глоббиновый Compile-шаринг втянул бы в корневой проект .cs
    поддерева вместе с его сгенерированными obj-атрибутами сборки —
    CS0579 «Повторяющийся атрибут» (тот же приём, что в корнях B-08/B-17).
  -->
  <ItemGroup>
    <Compile Remove="Groups\**\*.cs" />
    <None Remove="Groups\**" />
    <Content Remove="Groups\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\api\LabsApp\LabsApp.csproj" />
  </ItemGroup>

</Project>
