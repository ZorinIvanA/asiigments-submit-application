<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Интеграционные тесты батча B-10 (Api.Auth.Core и лимитер: KDF-счётчик —
    FR-005/NFR-004, cookie-матрица и токены — FR-008/NFR-007/NFR-006, конфигурация
    ключа подписи — FR-006/FR-008, память лимитера — NFR-003/FR-003, ключ IP
    регистраций — FR-004). Зона батча: tests/integration/B-10. Реализация (src/api)
    не изменяется: LabsApp остаётся net8.0 (FR-001); зона ссылается на него
    ProjectReference и не включается в solution src/api — батчи пишут зоны
    параллельно (урок BL-001 BUG-001: собственный проект зоны вместо правки
    общего тестового проекта).

    Тестовый проект — net10.0 (адаптация окружения прогона, как у зон B-01..B-21):
    на хосте только SDK 10.0.112 и runtime 9/10, runtime .NET 8 отсутствует.
    Microsoft.AspNetCore.Mvc.Testing 10.0.12 — под net10.0: TestServer реализует
    PipeWriter.UnflushedBytes, требуемый System.Text.Json фреймворка 9/10.
    Microsoft.Extensions.TimeProvider.Testing 8.10.0 — FakeTimeProvider для
    детерминированных окон лимитера (кейс TS-210, FR-003 «инжектируемые часы»).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\api\LabsApp\LabsApp.csproj" />
  </ItemGroup>

</Project>
