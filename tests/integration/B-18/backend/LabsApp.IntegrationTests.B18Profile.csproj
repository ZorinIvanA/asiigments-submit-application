<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Интеграционные тесты батча B-18 (стадия tests, вход c-429): профиль
    GET/PUT /api/v1/me/profile — FR-015 (TS-086..TS-092, TS-200) и смена пароля
    PUT /api/v1/me/password — FR-016/IF-013, арбитраж ISS-002 (TS-093..TS-098,
    TS-206). Зона батча: tests/integration/B-18; проект размещён в подкаталоге
    backend/, чтобы не пересекать obj/bin с проектом клиентских сценариев
    предыдущей волны (LabsApp.IntegrationTests.B18.csproj в корне зоны — другой
    набор сценариев, файлы не модифицируются).

    Код реализации (src/api, включая LabsApp.Tests) не изменяется; собственная
    инфраструктура зоны — изоляция от чужих тестовых зон (урок BL-001 BUG-001:
    параллельные батчи пишут соседние test-зоны, и сквозной прогон ловит их
    полузаписанные файлы как flaky). Проект не включается в solution src/api.
    HTTP-сценарии ссылаются на LabsApp ProjectReference и поднимают собственные
    WebApplicationFactory-хосты (образец — зоны B-03/B-16). Все классы зоны —
    в одной последовательной коллекции (B18ProfileSerialCollection):
    детерминированный порядок выполнения хостов зоны без параллельных сессий
    MSBuild над общим obj/bin LabsApp (BL-001).

    Тестовый проект — net10.0 (адаптация окружения прогона, как в зонах
    B-01..B-16): на хосте только SDK 10.0.112 и runtime 9/10, runtime .NET 8
    отсутствует. Microsoft.AspNetCore.Mvc.Testing 10.0.12 — под net10.0.
    Проверяемое поведение — HTTP-контракты /api/v1, не зависящие от TFM
    тестового хоста.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\api\LabsApp\LabsApp.csproj" />
  </ItemGroup>

</Project>
