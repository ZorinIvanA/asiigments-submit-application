<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Интеграционные тесты батча B-05 (домен студенты/ведомости: поиск, группы,
    страница, upsert сдач, 400/404/409-порядки, контракт ошибок и словарь §8 —
    FR-019/FR-020/FR-021/FR-024/NFR-007; сценарии аутентификации и лимитеров
    удалены раундом де-авторизации).
    Зона батча: tests/integration/B-05. Реализация (src/api) не изменяется: LabsApp
    остаётся net8.0 (FR-001); зона ссылается на него ProjectReference и не включается
    в solution src/api — батчи пишут зоны параллельно (образец — зоны B-01/B-02;
    урок BL-001 BUG-001: собственный проект зоны вместо правки общего LabsApp.Tests).

    Тестовый проект — net8.0 (ранее net10.0 — адаптация окружения прогона без runtime 8, как у зон B-01/B-02):
    на исходном хосте прогона не было runtime .NET 8 (только SDK 10 и runtime 9/10); с рантаймом 8.x зона возвращена на net8.0 и Mvc.Testing 8.0.*.
    Mvc.Testing 10.0.12 (историческое обоснование прежнего net10.0) — под net10.0: TestServer реализует
    PipeWriter.UnflushedBytes, требуемый System.Text.Json фреймворка 9/10.
    Проверяемое поведение — HTTP-контракты /api/v1, не зависящие от TFM тестового хоста.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TestInfrastructure\LabsApp.TestInfrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\api\LabsApp\LabsApp.csproj" />
  </ItemGroup>

  <!--
    Раунд де-авторизации: аутентификация/лимитеры удалены из src/api/LabsApp
    (эндпойнты /api/v1/auth/*, ITokenService/IPasswordHasher, ApplicationRateLimiters,
    IClientIpResolver не существуют). Legacy-кластер прошлых раундов (B05Security*,
    B05FakeTimeProvider/B05LogSink, B05MintedSessions, Ts033..Ts037 — хэши/JWT/
    refresh-токены и лимитерно-прокси-сценарии Ts163..Ts170) и сценарии /auth/register
    (Ts119 401→403, Ts120 429→400, Ts147 гонка регистраций, Ts154 429, Ts160/161
    границы регистрации, Ts168 счётчик регистраций, Ts169 пароль) удалены из зоны
    по правилам гигиены AGENTS.md — тесты отказанного функционала не хранятся.
  -->


  <!--
    Опись раунда c-954 (кейсы TS-116..TS-125, TS-159, TS-161, TS-167, TS-168,
    TS-174): староволновые дубликаты выведены из компиляции по описи —
    Ts142/Ts143/Ts146 заменены файлами с текущими номерами Ts117/Ts116/Ts121
    (конкурентный стимул Ts146 воспроизведён в Ts121, РЕВ-ISS-001); Ts159 —
    копия, канонический файл создан в зоне-владельце tests/integration/B-03
    (доменная зона списков работ). Регистрационные копии Ts161_EmailBoundary,
    Ts161_RegisterNonStringFields и Ts168_RegisterCounterCounts удалены в раунд
    де-авторизации (эндпойнт /auth/register не существует). Доменные файлы
    остаются в зоне для возможного портирования владельцем раунда
    (one-file-one-writer). Критерий закрытия: dotnet build зоны — 0 ошибок,
    dotnet test фильтром батча запускается.
  -->
  <ItemGroup>
    <Compile Remove="Scenarios\Ts142_SubmissionsGridUnknownGroupTests.cs" />
    <Compile Remove="Scenarios\Ts143_SubmissionsGridMissingSemesterTests.cs" />
    <Compile Remove="Scenarios\Ts146_ConcurrentSubmissionUpsertTests.cs" />
    <Compile Remove="Scenarios\Ts159_LabsSortNormalizationTests.cs" />
  </ItemGroup>

  <!--
    Опись раунда c-1128 (кейсы TS-107..TS-115, зона-владелец students/submissions):
    староволновые дубликаты выведены из компиляции по описи кейсов — стимул каждого
    воспроизведён файлом с текущим номером: Ts130 → Ts108 (токены в разных полях
    не складываются), Ts131/Ts134 → Ts109 (groupId=none и неизвестный uuid),
    Ts132/Ts133 → Ts110 (граница длины поиска 200/201), Ts135 → Ts111 (перевод
    в группу), Ts136 → Ts112 (исключение из группы), Ts137/Ts138/Ts139 → Ts113
    (404 для не-студента/неизвестного id/неизвестной группы), Ts140/Ts144 → Ts114
    (ведомость первой страницы, ru-порядок, дискриминирующие ФИО), Ts141 → Ts115
    (поле page в ответе, AR-003). Названные в given кейсов Ts113 имена
    «Ts141_StudentsExcludeTeachers» и «Ts144_PutStudentGroupRemove» в фактическом
    дереве отсутствуют; ссылка «Ts145..Ts147» коллизирует с ТЕКУЩИМИ номерами
    конкурентных кейсов TS-145..TS-147 этой зоны (файлы Ts145/Ts147 —
    FR-014/FR-002, Ts146 уже выведен раундом c-954) — эти файлы описью не
    выводятся (запрос на изменение кейса TS-113). Ts142_PutStudentGroupAssign
    из given TS-111 в дереве отсутствует (фактический Ts142 выведен раундом
    c-954). Файлы остаются в зоне для возможного портирования владельцем раунда
    (one-file-one-writer). Критерий закрытия: dotnet build зоны — 0 ошибок,
    dotnet test фильтром батча зелёный.
  -->
  <ItemGroup>
    <Compile Remove="Scenarios\Ts130_StudentsCrossFieldTokensTests.cs" />
    <Compile Remove="Scenarios\Ts131_StudentsGroupNoneFilterTests.cs" />
    <Compile Remove="Scenarios\Ts132_StudentsSearchTooLongTests.cs" />
    <Compile Remove="Scenarios\Ts133_StudentsSearchBoundary200Tests.cs" />
    <Compile Remove="Scenarios\Ts134_StudentsUnknownGroupUuidTests.cs" />
    <Compile Remove="Scenarios\Ts135_StudentsAssignGroupTests.cs" />
    <Compile Remove="Scenarios\Ts136_StudentsExcludeGroupTests.cs" />
    <Compile Remove="Scenarios\Ts137_StudentsTeacherNotStudentTests.cs" />
    <Compile Remove="Scenarios\Ts138_StudentsUnknownStudentTests.cs" />
    <Compile Remove="Scenarios\Ts139_StudentsUnknownTargetGroupTests.cs" />
    <Compile Remove="Scenarios\Ts140_SubmissionsGridFirstPageTests.cs" />
    <Compile Remove="Scenarios\Ts141_SubmissionsGridPageFieldTests.cs" />
    <Compile Remove="Scenarios\Ts144_SubmissionsGridSemesterRangeTests.cs" />
  </ItemGroup>

</Project>
