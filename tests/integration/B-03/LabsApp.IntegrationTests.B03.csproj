<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Интеграционные тесты батча B-03 (TS-031..TS-038 — регистрация FR-006 c гейтом
    Δkdf FR-004(б)/FR-024; TS-088..TS-094 — список и создание работ FR-017). Зона
    батча: tests/integration/B-03. Реализация (src/api) не изменяется: LabsApp
    остаётся net8.0 (FR-001); зона ссылается на него ProjectReference и не включается
    в solution src/api — батчи пишут зоны параллельно (образец — зоны B-01/B-02;
    урок BL-001 BUG-001: собственный проект зоны вместо правки общего
    LabsApp.Tests.csproj).

    Тестовый проект — net10.0 (адаптация окружения прогона, как у зон B-01/B-02): на хосте
    только SDK 10.0.112 и runtime 9/10, runtime .NET 8 отсутствует. Microsoft.AspNetCore.Mvc.Testing
    10.0.12 — под net10.0: TestServer реализует PipeWriter.UnflushedBytes, требуемый
    System.Text.Json фреймворка 9/10 (в TestServer 8.0.x запись JSON ломается
    «The PipeWriter ... does not implement PipeWriter.UnflushedBytes»).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\api\LabsApp\LabsApp.csproj" />
  </ItemGroup>

</Project>
