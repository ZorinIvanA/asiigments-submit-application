<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Интеграционные тесты батча B-06 (аутентификация/авторизация и регистрация:
    TS-026..TS-032, TS-038..TS-045 — FR-011, FR-012, NFR-010).
    Зона батча: tests/integration/B-06. Реализация (src/api) не изменяется: LabsApp
    остаётся net8.0 (FR-001); зона ссылается на него ProjectReference и не включается
    в solution src/api — батчи пишут зоны параллельно (образец — зоны B-01..B-07;
    урок BL-001 BUG-001: собственный проект зоны вместо правки общего LabsApp.Tests).

    Тестовый проект — net8.0 (ранее net10.0 — адаптация окружения прогона без runtime 8, как у зон B-01..B-07):
    на исходном хосте прогона не было runtime .NET 8 (только SDK 10 и runtime 9/10); с рантаймом 8.x зона возвращена на net8.0 и Mvc.Testing 8.0.*.
    Mvc.Testing 10.0.12 (историческое обоснование прежнего net10.0) — под net10.0: TestServer реализует
    PipeWriter.UnflushedBytes, требуемый System.Text.Json фреймворка 9/10.
    Проверяемое поведение — HTTP-контракты /api/v1, не зависящие от TFM тестового хоста.

    Microsoft.Extensions.TimeProvider.Testing — FakeTimeProvider кейса TS-031
    (детерминированный перевод бизнес-времени на Auth__AccessTtlMinutes+1 минуту,
    глоссарий TimeProvider / ADR-010).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\api\LabsApp\LabsApp.csproj" />
  </ItemGroup>

</Project>
