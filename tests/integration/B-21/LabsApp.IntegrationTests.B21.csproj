<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Интеграционные тесты батча B-21 (сквозные NFR-проверки: TS-031/NFR-004,
    TS-188/NFR-005, TS-189/NFR-006, TS-191 + TS-185/NFR-002, TS-193/NFR-001,
    TS-194 + TS-195/NFR-007, TS-196/NFR-008).
    Зона батча: tests/integration/B-21. Реализация (src/api) не изменяется;
    собственные копии инфраструктуры (B21WebAppFactory/B21LogSink/B21Sessions/
    B21DomainSeed/B21ProcessRunner) — изоляция от чужих тестовых зон (урок
    BL-001 BUG-001: параллельные батчи пишут соседние зоны).
    Проект сознательно не включается в src/api/LabsApp.sln.
  -->

  <PropertyGroup>
    <!--
      Тестовый проект целится в runtime, фактически установленный на хосте прогона
      (ASP.NET Core 10): TestHost-пакет 8.0.x несовместим с runtime 10 (как в зоне
      B-01). Само приложение остаётся net8.0; для дочернего прогона
      `dotnet test` над src/api (TS-182) тест выставляет DOTNET_ROLL_FORWARD=LatestMajor.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- TS-031 (NFR-004): FakeTimeProvider — «инжектируемые часы» кейса
         (перевод тестового времени на 60 с без реального ожидания). -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\api\LabsApp\LabsApp.csproj" />
  </ItemGroup>

  <!--
    Последовательное исполнение коллекций зоны: замер p95 (TS-193) не должен
    конкурировать за CPU с другими тест-классами батча.
  -->
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
