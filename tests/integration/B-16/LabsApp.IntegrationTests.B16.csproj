<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Интеграционные тесты батча B-16 (зона tests/integration/B-16):
     - профиль: GET/PUT /api/v1/me/profile — FR-015 (TS-079..TS-082);
     - смена пароля: PUT /api/v1/me/password — FR-016/IF-013, арбитраж ISS-002
       (TS-083..TS-087).
    Дополнительные файлы Ts091/Ts092/Ts098/Ts147/Ts200/Ts206 — покрытие граничных
    веток тех же контрактов из предыдущей нумерации сценариев раунда (не кейсы
    текущего батча, сохранены без изменений).
    Код реализации (src/api, включая LabsApp.Tests) не изменяется; собственная
    инфраструктура зоны — изоляция от чужих тестовых зон (урок BL-001 BUG-001:
    параллельные батчи пишут соседние test-зоны, и сквозной прогон ловит их
    полузаписанные файлы как flaky). Проект не включается в solution src/api.
    HTTP-сценарии ссылаются на LabsApp ProjectReference и поднимают собственные
    WebApplicationFactory-хосты (образец — зоны B-01..B-15). Все классы зоны —
    в одной последовательной коллекции (SerialBuildAndProcessCollection):
    детерминированный порядок выполнения хостов зоны без параллельных сессий
    MSBuild над общим obj/bin LabsApp (BL-001).

    Тестовый проект — net10.0 (адаптация окружения прогона, как в зонах B-01..B-15):
    на хосте только SDK 10.0.112 и runtime 9/10, runtime .NET 8 отсутствует.
    Microsoft.AspNetCore.Mvc.Testing 10.0.12 — под net10.0: TestServer реализует
    PipeWriter.UnflushedBytes, требуемый System.Text.Json фреймворка 9/10.
    Проверяемое поведение — HTTP-контракты /api/v1, не зависящие от TFM тестового хоста.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\api\LabsApp\LabsApp.csproj" />
  </ItemGroup>

</Project>
