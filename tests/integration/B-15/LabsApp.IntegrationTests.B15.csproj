<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Интеграционные тесты батча B-15 (профиль: GET/PUT /api/v1/me/profile — FR-015/
    FR-021, семестры — FR-018). Зона батча: tests/integration/B-15. Реализация
    (src/api) не изменяется: LabsApp остаётся net8.0 (FR-001); зона ссылается на
    него ProjectReference и не включается в solution src/api — батчи пишут зоны
    параллельно (образец — зоны B-01..B-07; урок BL-001 BUG-001: собственный
    проект зоны вместо правки общего LabsApp.Tests).

    Аутентификации в приложении нет: все эндпоинты публичны, «текущий
    пользователь» — засеянный преподаватель (Seed__TeacherLogin, умолчание
    «teacher»); сценарии зоны ходят анонимным клиентом фабрики (B15Harness.
    CreateClient), сессии/JWT-минт в зоне отсутствуют.

    Тестовый проект — net8.0 (ранее net10.0 — адаптация окружения прогона без runtime 8, как у зон B-01..B-07):
    на исходном хосте прогона не было runtime .NET 8 (только SDK 10 и runtime 9/10); с рантаймом 8.x зона возвращена на net8.0 и Mvc.Testing 8.0.*.
    Mvc.Testing 10.0.12 (историческое обоснование прежнего net10.0) — под net10.0: TestServer реализует
    PipeWriter.UnflushedBytes, требуемый System.Text.Json фреймворка 9/10.
    Проверяемое поведение — HTTP-контракты /api/v1, не зависящие от TFM тестового хоста.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TestInfrastructure\LabsApp.TestInfrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\api\LabsApp\LabsApp.csproj" />
  </ItemGroup>

  <!--
    Поддерево Groups/ (переизданный батч B-15, кейсы групп TS-102..TS-106,
    TS-160) собирается ОТДЕЛЬНЫМ тестовым проектом
    Groups/LabsApp.IntegrationTests.B15.Groups.csproj (образец — подпроекты
    B-14/Groups, B-17/Groups, B-08/Groups; урок BL-001 BUG-001: собственный
    проект поддерева зоны). Без исключения глоббиновый Compile-шаринг втянул бы
    те же .cs в корневой проект зоны — дублирующаяся компиляция одного исходника
    в две сборки.
  -->
  <ItemGroup>
    <Compile Remove="Groups\**\*.cs" />
  </ItemGroup>

</Project>
