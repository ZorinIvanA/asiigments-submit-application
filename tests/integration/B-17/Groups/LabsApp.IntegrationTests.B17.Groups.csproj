<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Интеграционные тесты батча B-17 (группы: список/CRUD/состав — FR-019, FR-020;
    кейсы TS-122..TS-128, TS-202, TS-204). Зона батча: tests/integration/B-17 —
    обособленный тестовый проект в поддереве Groups/ (образец — собственные
    проекты зон B-01..B-21 и подпроект B-08/Groups; урок BL-001 BUG-001:
    собственный проект вместо правки чужих). Файлы предыдущих волн зоны B-17
    (Scenarios/Ts068..Ts190 — recovery, Infrastructure/B17*, *.spec.ts) не
    изменяются и не используются: этот проект собирает ТОЛЬКО поддерево Groups/.

    Реализация (src/api) не изменяется: LabsApp остаётся net8.0 (FR-001); зона
    ссылается на него ProjectReference. Тестовый проект — net10.0 (адаптация
    окружения прогона, как у зон B-01..B-21): на хосте только SDK 10.0.112 и
    runtime 9/10, runtime .NET 8 отсутствует. Microsoft.AspNetCore.Mvc.Testing
    10.0.12 — под net10.0: TestServer реализует PipeWriter.UnflushedBytes,
    требуемый System.Text.Json фреймворка 9/10. Проверяемое поведение —
    HTTP-контракты /api/v1, не зависящие от TFM тестового хоста.

    Сессии — минт access-JWT через ITokenService тестового хоста (ADR-015:
    DI-сид + минт вместо POST /auth/login, доменная волна групп не зависит от
    auth-эндпоинтов); данные given — демо-сид Seed__DemoData=true (точное
    воспроизведение src/client/app/mock/seed.ts: ИК-221 (25 студентов),
    ИК-222 (5), ИК-223 (0), student01..student32) либо пустое хранилище с
    сид-преподавателем.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Глобальные using этого проекта — ТОЛЬКО через MSBuild-элемент Using (не
    файлом GlobalUsings.cs): файл зоны tests/integration/B-17/GlobalUsings.cs
    предыдущей волны остаётся вне этого проекта, а повторные global using
    (TreatWarningsAsErrors) недопустимы.
  -->
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\api\LabsApp\LabsApp.csproj" />
  </ItemGroup>

</Project>
